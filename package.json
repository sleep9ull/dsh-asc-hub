{
  "name": "@sleep9ull/dsh-asc-hub",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin: an App Store Connect console that installs and inherits the asc CLI, signs in through the macOS Keychain, and ships builds to TestFlight, submits releases and reads sales.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "app-store-connect",
    "asc",
    "ios",
    "testflight",
    "release"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.smoke.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/*.test.js",
    "smoke": "npm run build && node --experimental-strip-types client/__smoke__.mts",
    "verify": "npm run check && npm test && node --experimental-strip-types client/__smoke__.mts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "author": "sleep9ull",
  "homepage": "https://github.com/sleep9ull/dsh-asc-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleep9ull/dsh-asc-hub.git"
  },
  "bugs": {
    "url": "https://github.com/sleep9ull/dsh-asc-hub/issues"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
